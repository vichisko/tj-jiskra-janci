---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

import heroImg from '../assets/photos/stolni-tenis-hra.webp';
import cardImg1 from '../assets/photos/tym-stolni-tenis.webp';
import cardImg2 from '../assets/photos/detsky-den-diplomy.webp';
import cardImg3 from '../assets/photos/detsky-den-vsichni.webp';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="cs">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* ── Hero ── */
			.hero {
				display: grid;
				grid-template-columns: 60fr 40fr;
				min-height: 70vh;
				background: var(--color-white);
			}

			.hero-text {
				padding: 4rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}

			.hero-eyebrow {
				font-size: 0.85rem;
				font-weight: 600;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: var(--color-primary);
				margin: 0 0 1.25rem;
			}

			.hero-title {
				font-size: 5.5rem;
				font-weight: 900;
				line-height: 1;
				letter-spacing: -0.02em;
				color: var(--color-text);
				margin: 0;
			}

			.hero-stats {
				font-size: 0.85rem;
				font-weight: 600;
				letter-spacing: 0.15em;
				text-transform: uppercase;
				color: var(--color-gray-medium);
				margin: 2rem 0 0;
			}

			.hero-tagline {
				font-size: 1.05rem;
				color: var(--color-text);
				margin: 1.5rem 0 0;
			}

			.hero-buttons {
				display: flex;
				align-items: center;
				gap: 1.5rem;
				flex-wrap: wrap;
				margin-top: 2.5rem;
			}

			.btn-primary {
				display: inline-block;
				padding: 0.85em 2.2em;
				background: var(--color-primary);
				color: var(--color-white);
				text-decoration: none;
				border-radius: 4px;
				font-weight: 600;
				font-size: 1rem;
				transition:
					background 0.2s,
					transform 0.15s;
			}

			.btn-primary:hover {
				background: #a31830;
				transform: translateY(-2px);
			}

			.btn-secondary {
				display: inline-block;
				background: transparent;
				color: var(--color-text);
				text-decoration: none;
				font-weight: 600;
				font-size: 1rem;
				border-bottom: 2px solid transparent;
				padding-bottom: 1px;
				transition: border-color 0.2s;
			}

			.btn-secondary:hover {
				border-bottom-color: var(--color-primary);
			}

			.hero-image {
				overflow: hidden;
			}

			.hero-image :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center;
				display: block;
				border-radius: 0;
				max-width: none;
			}

			/* ── Divider ── */
			.section-divider {
				height: 1px;
				background: var(--color-gray-light);
				margin: 0 2rem;
			}

			/* ── Stats ── */
			.stats {
				background: var(--color-white);
				padding: 6rem 2rem;
			}

			.stats-inner {
				max-width: 1200px;
				margin: 0 auto;
			}

			.stats-eyebrow {
				font-size: 0.85rem;
				font-weight: 600;
				letter-spacing: 0.15em;
				text-transform: uppercase;
				color: var(--color-primary);
				text-align: center;
				margin: 0 0 3rem;
			}

			.stats-grid {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 3rem;
			}

			.stat {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
			}

			.stat-number {
				font-size: 5rem;
				font-weight: 900;
				line-height: 1;
				letter-spacing: -0.02em;
				color: var(--color-text);
			}

			.stat-label {
				font-size: 0.95rem;
				font-weight: 400;
				color: var(--color-gray-medium);
				margin-top: 0.75rem;
			}

			/* ── Feature cards ── */
			.features {
				padding: 5rem 1.5rem;
				background: var(--color-gray-light);
			}

			.features-inner {
				max-width: 1200px;
				margin: 0 auto;
			}

			.features-heading {
				font-size: 2rem;
				font-weight: 700;
				color: var(--color-text);
				margin: 0 0 2rem;
				text-transform: lowercase;
			}

			.features-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 2rem;
			}

			.feature-card {
				background: var(--color-white);
				border-radius: 8px;
				overflow: hidden;
				text-decoration: none;
				color: inherit;
				box-shadow: var(--box-shadow);
				transition:
					transform 0.25s,
					box-shadow 0.25s;
				display: block;
			}

			.feature-card:hover {
				transform: translateY(-4px);
				box-shadow: var(--box-shadow-hover);
			}

			.feature-card-img {
				aspect-ratio: 16 / 10;
				overflow: hidden;
			}

			.feature-card-img :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				transition: transform 0.4s ease;
				display: block;
			}

			.feature-card:hover .feature-card-img :global(img) {
				transform: scale(1.04);
			}

			.feature-card-body {
				padding: 1.5rem;
			}

			.feature-card-body h3 {
				font-size: 1.15rem;
				margin-bottom: 0.5rem;
				color: var(--color-black);
			}

			.feature-card-body p {
				margin: 0;
				font-size: 0.9rem;
				color: var(--color-gray-medium);
				line-height: 1.55;
			}

			/* ── Responsive ── */
			@media (max-width: 900px) {
				.hero {
					grid-template-columns: 1fr;
					min-height: auto;
				}

				.hero-text {
					padding: 2rem;
					order: 1;
				}

				.hero-title {
					font-size: 3rem;
				}

				.hero-image {
					order: 2;
					height: 55vw;
					min-height: 240px;
				}

				.stats {
					padding: 4rem 1rem;
				}

				.stats-grid {
					grid-template-columns: repeat(2, 1fr);
					gap: 2rem;
				}

				.stat-number {
					font-size: 3.5rem;
				}

				.features-grid {
					grid-template-columns: 1fr;
					max-width: 540px;
					margin: 0 auto;
				}

				.features {
					padding: 3rem 1.25rem;
				}
			}

			@media (max-width: 480px) {
				.stats-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />

		<section class="hero">
			<div class="hero-text">
				<p class="hero-eyebrow">Tělovýchovná jednota</p>
				<h1 class="hero-title">TJ Jiskra Jančí</h1>
				<p class="hero-stats">1976 · 50 let · 3 okresní celky · Jančí</p>
				<p class="hero-tagline"><em>„Společně k aktivnímu životnímu stylu."</em></p>
				<div class="hero-buttons">
					<a href={`${base}/about`} class="btn-primary">o klubu</a>
					<a href={`${base}/stolni-tenis`} class="btn-secondary">stolní tenis</a>
				</div>
			</div>
			<div class="hero-image">
				<Image
					src={heroImg}
					alt="Stolní tenis v TJ Jiskra Jančí"
					width={800}
					height={700}
					loading="eager"
				/>
			</div>
		</section>

		<div class="section-divider"></div>

		<section class="stats">
			<div class="stats-inner">
				<p class="stats-eyebrow">Jančí v číslech</p>
				<div class="stats-grid">
					<div class="stat">
						<span class="stat-number">50</span>
						<span class="stat-label">let nepřetržité existence</span>
					</div>
					<div class="stat">
						<span class="stat-number">67</span>
						<span class="stat-label">aktivních členů oddílu</span>
					</div>
					<div class="stat">
						<span class="stat-number">3</span>
						<span class="stat-label">týmy v&nbsp;okresním přeboru</span>
					</div>
					<div class="stat">
						<span class="stat-number">1976</span>
						<span class="stat-label">rok založení klubu</span>
					</div>
				</div>
			</div>
		</section>

		<div class="section-divider"></div>

		<section class="features">
			<div class="features-inner">
				<h2 class="features-heading">co u nás najdete</h2>
				<div class="features-grid">
					<a class="feature-card" href={`${base}/stolni-tenis`}>
						<div class="feature-card-img">
							<Image
								src={cardImg1}
								alt="Tým stolního tenisu TJ Jiskra Jančí"
								width={600}
								height={375}
							/>
						</div>
						<div class="feature-card-body">
							<h3>stolní tenis</h3>
							<p>
								Tři družstva v&nbsp;okresních a&nbsp;krajských soutěžích. Aktivní mládežnická sekce,
								tréninky každé pondělí.
							</p>
						</div>
					</a>

					<a class="feature-card" href={`${base}/akce`}>
						<div class="feature-card-img">
							<Image
								src={cardImg2}
								alt="Akce a turnaje TJ Jiskra Jančí"
								width={600}
								height={375}
							/>
						</div>
						<div class="feature-card-body">
							<h3>akce a turnaje</h3>
							<p>
								Globus, Velikonoční turnaj, Dětský den, Vánoční turnaj. Sportovní život pro celé
								Březovsko.
							</p>
						</div>
					</a>

					<a class="feature-card" href={`${base}/historie`}>
						<div class="feature-card-img">
							<Image
								src={cardImg3}
								alt="Padesát let TJ Jiskra Jančí"
								width={600}
								height={375}
							/>
						</div>
						<div class="feature-card-body">
							<h3>padesát let klubu</h3>
							<p>
								Od roku 1976 dodnes. Klub sdružuje 67 členů z&nbsp;Jančí a&nbsp;okolních obcí.
							</p>
						</div>
					</a>
				</div>
			</div>
		</section>

		<Footer />
	</body>
</html>
