---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer>
	<div class="footer-inner">
		<div class="footer-grid">

			<!-- Column 1: Brand -->
			<div class="col-brand">
				<p class="brand-name">TJ Jiskra Jančí</p>
				<p class="brand-sub"><em>Tělovýchovná jednota, z.&nbsp;s. — od roku 1976.</em></p>
			</div>

			<!-- Column 2: Navigation -->
			<div class="col-nav">
				<p class="col-eyebrow">Navigace</p>
				<nav>
					<a href={`${base}/`}>úvod</a>
					<a href={`${base}/about`}>o klubu</a>
					<a href={`${base}/historie`}>historie</a>
					<a href={`${base}/stolni-tenis`}>stolní tenis</a>
					<a href={`${base}/akce`}>akce</a>
					<a href={`${base}/blog`}>aktuality</a>
					<a href={`${base}/kontakt`}>kontakt</a>
				</nav>
			</div>

			<!-- Column 3: Contact + Social -->
			<div class="col-contact">
				<p class="col-eyebrow">Kontakt</p>
				<address>
					Jančí 62, 747 44 Březová<br />
					<a href="mailto:tjjiskrajanci@seznam.cz">tjjiskrajanci@seznam.cz</a><br />
					605 251 525
				</address>

				<p class="col-eyebrow col-eyebrow--spaced">Najdete nás</p>
				<div class="social-links">
					<a
						href="https://www.facebook.com/TJ.Jiskra.Janci"
						target="_blank"
						rel="noopener noreferrer"
					>Facebook</a>
					<a
						href="https://iscus.cz/web/sportovni-subjekty/3806101"
						target="_blank"
						rel="noopener noreferrer"
					>Česká unie sportu</a>
				</div>
			</div>

		</div>

		<hr class="footer-rule" />

		<div class="footer-bottom">
			<span class="copyright">© 2026 Tělovýchovná jednota Jiskra Jančí, z.&nbsp;s.</span>
			<span class="motto"><em>„Společně k aktivnímu životnímu stylu."</em></span>
		</div>
	</div>
</footer>

<style>
	footer {
		background: var(--color-text);
		color: var(--color-white);
		padding: 5rem 2rem;
	}

	.footer-inner {
		max-width: 1200px;
		margin: 0 auto;
	}

	/* ── Three-column grid ── */
	.footer-grid {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: 3rem;
	}

	/* ── Column 1: Brand ── */
	.brand-name {
		font-size: 2rem;
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.01em;
		color: var(--color-white);
		margin: 0;
	}

	.brand-sub {
		font-size: 0.85rem;
		color: rgba(255, 255, 255, 0.5);
		margin: 0.75rem 0 0;
		font-style: italic;
	}

	/* ── Eyebrow headings ── */
	.col-eyebrow {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--color-primary);
		margin: 0 0 1.5rem;
	}

	.col-eyebrow--spaced {
		margin-top: 2rem;
	}

	/* ── Column 2: Navigation ── */
	.col-nav nav {
		display: flex;
		flex-direction: column;
	}

	.col-nav a {
		color: var(--color-white);
		text-decoration: none;
		font-size: 0.95rem;
		line-height: 2.2;
		transition: color 0.2s;
	}

	.col-nav a:hover {
		color: var(--color-primary);
	}

	/* ── Column 3: Contact + Social ── */
	address {
		font-style: normal;
		font-size: 0.95rem;
		line-height: 1.8;
		color: rgba(255, 255, 255, 0.75);
	}

	address a {
		color: rgba(255, 255, 255, 0.75);
		text-decoration: none;
		transition: color 0.2s;
	}

	address a:hover {
		color: var(--color-white);
	}

	.social-links {
		display: flex;
		flex-direction: column;
	}

	.social-links a {
		color: var(--color-white);
		text-decoration: none;
		font-size: 0.95rem;
		line-height: 2.2;
		transition: color 0.2s;
	}

	.social-links a:hover {
		color: var(--color-primary);
	}

	/* ── Separator ── */
	.footer-rule {
		border: none;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		margin: 4rem 0 2rem;
	}

	/* ── Bottom row ── */
	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.copyright,
	.motto {
		font-size: 0.8rem;
		color: rgba(255, 255, 255, 0.5);
	}

	/* ── Responsive ── */
	@media (max-width: 820px) {
		footer {
			padding: 3rem 1.5rem;
		}

		.footer-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.brand-name {
			font-size: 1.5rem;
		}

		.footer-bottom {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
